{
	"$schema": "https://spacefast.com/schemas/sf.json",
	"name": "Larder Log",
	// **This file is authoritative about access, and omitting it is an answer.**
	// A publish reconciles the space's grants against this key — it does not
	// leave them alone. Measured on 2026-09-10: publishing a payload whose
	// `sf.jsonc` had no `access` key took a space that was answering anonymous
	// requests and **revoked its public grant**, replacing it with a link grant;
	// declaring it here put the grant back on the next publish. Larder Log has
	// been public since v4 and every publish since has carried no `access` key,
	// so this is new behaviour rather than a rule we had been getting away with.
	// Without this line the next publish takes the app off the web.
	"access": "public",
	// The generated index.html takes its <title> from here, falling back to the
	// app name slug. Without it the browser tab reads "larder-log".
	"meta": {
		"title": "Larder Log"
	},
	"runtime": {
		"kind": "zero",
		"server": "server/index.ts",
		"client": "client/index.tsx"
	}
}
